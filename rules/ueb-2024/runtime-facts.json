{
  "whitespace": { "citation": { "source": "ueb-2024", "locator": "3.23" }, "blank": "⠀" },
  "grouping": { "citation": { "source": "ueb-2024", "locator": "3.4" }, "open": "⠣", "close": "⠜" },
  "ligature": { "citation": { "source": "ueb-2024", "locator": "4.3" }, "indicator": "⠘⠖" },
  "numeric": { "citation": { "source": "ueb-2024", "locator": "6.1-6.5" }, "punctuation": [",", "."] },
  "grade1Required": {
    "citation": { "source": "ueb-2024", "locator": "6.5.2; 7.5.4" },
    "sets": { "question": ["?"], "dash": ["-", "–", "—"] },
    "rules": [
      { "when": [
        { "unit": "self", "classes": ["lowercase-letter"] },
        { "unit": "self", "classes": ["numeric-ambiguous-letter"] },
        { "active": "numeric" }
      ] },
      { "when": [
        { "unit": "self", "sources": "question" },
        { "unit": "previous", "edge": true, "classes": ["sequence-boundary"], "sources": "dash" }
      ] }
    ]
  },
  "quotes": {
    "citation": { "source": "ueb-2024", "locator": "7.6" },
    "sets": {
      "opening": ["(", "[", "{", "‘", "“", "«"],
      "closing": [",", ";", ":", ".", "!", "?", ")", "]", "}", "'", "’", "”"],
      "possessive": ["s", "S"]
    },
    "rules": [
      { "source": "‘", "open": "single", "continue": true },
      { "source": "’", "when": [{ "elisionEnd": true }], "emit": "⠄" },
      { "source": "’", "when": [
        { "unit": "next", "classes": ["lowercase-letter", "uppercase-letter"] },
        { "unit": "previous", "classes": ["lowercase-letter", "uppercase-letter"] }
      ], "emit": "⠄" },
      { "source": "’", "when": [
        { "unit": "next", "classes": ["lowercase-letter", "uppercase-letter"] },
        { "unit": "previous", "edge": true, "classes": ["sequence-boundary"], "sources": "opening" },
        { "elisionWord": true }
      ], "markElision": true, "emit": "⠄" },
      { "source": "’", "when": [
        { "unit": "next", "classes": ["lowercase-letter", "uppercase-letter"] },
        { "unit": "previous", "edge": true, "classes": ["sequence-boundary"], "sources": "opening" }
      ], "open": "single", "emit": "⠠⠦" },
      { "source": "’", "when": [{ "open": "single" }], "close": "single" },
      { "source": "’", "when": [{ "unit": "previous", "sources": "possessive" }], "emit": "⠄" },
      { "source": "\"", "when": [{ "open": "double" }], "close": "double", "emit": "⠴" },
      { "source": "\"", "when": [
        { "unit": "previous", "edge": true, "classes": ["sequence-boundary"], "sources": "opening" },
        { "unit": "next", "edge": true, "classes": ["sequence-boundary"], "not": true }
      ], "open": "double", "emit": "⠦" },
      { "source": "\"", "when": [
        { "unit": "previous", "classes": ["digit"], "not": true },
        { "unit": "previous", "edge": true, "classes": ["sequence-boundary"], "not": true },
        { "unit": "next", "skip": "closing", "edge": true, "classes": ["sequence-boundary"] }
      ], "emit": "⠴" }
    ],
    "apostrophePrint": "’",
    "apostrophe": "⠄"
  },
  "standing": {
    "citation": { "source": "ueb-2024", "locator": "2.6" },
    "when": [
      { "unit": "previous", "skip": "openingStandingPunctuation", "edge": true, "classes": ["sequence-boundary"], "sources": "standingBoundaries" },
      { "unit": "next", "skip": "closingStandingPunctuation", "edge": true, "classes": ["sequence-boundary"], "sources": "standingBoundaries" }
    ]
  },
  "lowerSigns": {
    "citation": { "source": "ueb-2024", "locator": "10.5" },
    "within": [{ "unit": "self", "classes": ["lowercase-letter", "uppercase-letter", "digit", "sequence-boundary"], "not": true }],
    "facts": {
      "hasLowerPunctuation": [{ "when": [{ "unit": "self", "sources": "lowerPunctuation" }] }],
      "hasRestrictingLowerPunctuation": [
        { "when": [{ "unit": "self", "sources": "lowerPunctuation" }, { "unit": "self", "sources": "elisionPunctuation", "not": true }] },
        { "when": [{ "unit": "self", "sources": "lowerPunctuation" }, { "unit": "previous", "classes": ["lowercase-letter", "uppercase-letter"], "not": true }] },
        { "when": [{ "unit": "self", "sources": "lowerPunctuation" }, { "unit": "next", "classes": ["lowercase-letter", "uppercase-letter"], "not": true }] }
      ],
      "hasUpperPunctuation": [{ "when": [{ "unit": "self", "sources": "lowerPunctuation", "not": true }] }]
    }
  },
  "typeforms": {
    "citation": { "source": "ueb-2024", "locator": "9.2-9.4" },
    "modes": {
      "bold": "typeform-bold",
      "italic": "typeform-italic",
      "script": "typeform-script",
      "transcriber-defined": "typeform-transcriber-defined",
      "underline": "typeform-underline"
    }
  },
  "foreignCode": {
