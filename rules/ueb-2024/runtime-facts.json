    "nonUebIndicators": { "word": "⠘⠷", "wordTerminator": "⠘⠾", "passage": "⠐⠷⠄", "passageTerminator": "⠠⠐⠾" },
    "baseLetters": "^[a-z]$",
    "languages": {
      "de": {
        "capital": "⠠",
        "letters": { "ä": "⠜", "ö": "⠪", "ü": "⠳", "ß": "⠮" },
        "uppercase": { "ß": "ẞ" }
      },
      "fr": {
        "capital": "⠨",
        "letters": {
          "à": "⠷", "â": "⠡", "ç": "⠯", "é": "⠿", "è": "⠮", "ê": "⠣", "ë": "⠫",
          "î": "⠩", "ï": "⠻", "ô": "⠹", "œ": "⠪", "ù": "⠾", "û": "⠱", "ü": "⠳"
        },
        "uppercase": {}
      }
    }
  },
  "modeOrder": {
