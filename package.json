{
  "name": "ueb-translator",
  "version": "0.0.0",
  "description": "A tiny, standards-driven Unified English Braille translator for browsers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backtranslation": {
      "types": "./dist/backtranslation.d.ts",
      "import": "./dist/backtranslation.js"
    },
    "./grade2": {
      "types": "./dist/grade2.d.ts",
      "import": "./dist/grade2.js"
    },
    "./grade2/diagnostics": {
      "types": "./dist/grade2-diagnostics.d.ts",
      "import": "./dist/grade2-diagnostics.js"
    },
    "./technical": {
      "types": "./dist/technical.d.ts",
      "import": "./dist/technical.js"
    }
  },
  "scripts": {
    "browser:test": "vitest run --config vitest.browser.config.ts",
    "browser:typecheck": "tsc -p tsconfig.browser.json --noEmit",
    "build": "node scripts/clean-dist.mts && tsc -p tsconfig.build.json",
    "check": "npm run grade2:generate:check && npm run build && npm run typecheck && npm run browser:typecheck && npm run rules:typecheck && npm run oracle:typecheck && npm run lint && npm run test && npm run browser:test && npm run oracle:test",
    "grade2:generate": "npm run grade2:rules:build && node scripts/generate-grade2.mts",
    "grade2:generate:check": "npm run grade2:rules:build && node scripts/generate-grade2.mts --check",
    "grade2:rules:build": "tsc -p rules/ueb-2024/tsconfig.build.json",
    "lint": "eslint .",
    "oracle": "node node_modules/.cache/ueb-translator/liblouis-oracle/cli.js",
    "oracle:build": "tsc -p tools/liblouis-oracle/tsconfig.build.json",
    "oracle:smoke": "node node_modules/.cache/ueb-translator/liblouis-oracle/smoke.js",
    "oracle:test": "vitest run --coverage.enabled=false tools/liblouis-oracle/test",
    "oracle:typecheck": "tsc -p tools/liblouis-oracle/tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "rules:typecheck": "tsc -p tools/rule-compiler/tsconfig.json --noEmit",
    "size": "node scripts/report-size.mts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
