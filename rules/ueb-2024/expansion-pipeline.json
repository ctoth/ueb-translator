{
  "functions": {
    "shortformSuffixes": {
      "params": ["word"],
      "body": {"at": [
        {"find": ["@shortformSuffixes.exceptions", "group", {"in": ["$word", "$group.words"]}]},
        "suffixes",
        "@shortformSuffixes.default"
      ]}
    },
    "longerPattern": {
      "params": ["guards", "literal"],
      "body": {"concat": [
        {"if": [{"some": ["$guards", "guard", {"eq": ["$guard.kind", "word-start"]}]}, "^", ""]},
        "(?=(", "$literal", ")",
        {"join": [{"each": [
          {"where": ["$guards", "guard", {"eq": ["$guard.kind", "following-not-vowel-y"]}]},
          "guard", {"concat": ["(?![", "$guard.characters", "])"]}
        ]}, ""]},
        ")"
      ]}
    },
    "constraintWords": {
      "params": ["guard"],
      "body": {"flatten": {"each": [
        {"flatten": {"each": ["$guard.words", "word", {"if": [
          {"isText": "$word"},
          {"list": ["$word"]},
          {"concat": [{"list": ["$word.base"]}, {"each": ["$word.suffixes", "suffix", {"concat": ["$word.base", "$suffix"]}]}]}
        ]}]}},
        "word",
        {"if": ["$guard.possessives",
          {"concat": [
            {"list": ["$word"]},
            {"each": ["@expansion.possessives.suffixes", "suffix", {"concat": ["$word", "$suffix"]}]},
            {"flatten": {"each": [
              {"where": ["@expansion.possessives.endings", "ending", {"endsWith": ["$word", "$ending.ending"]}]},
              "ending", {"each": ["$ending.suffixes", "suffix", {"concat": ["$word", "$suffix"]}]}
            ]}}
          ]},
          {"list": ["$word"]}
        ]}
      ]}}
    }
  },
  "steps": [
    {"name": "families", "op": "table", "source": "families"},
    {"name": "groups", "op": "table", "source": "groups"},
    {"name": "groupEntries", "op": "flatMap", "from": "groups", "rows": {"each": ["$row.entries", "entry", {"record": {
      "kind": "$row.kind", "precedence": "$row.precedence", "guards": "$row.guards",
      "variants": {"default": [{"optional": "row.variants"}, {"list": []}]},
      "print": "$entry.0", "braille": "$entry.1"
    }}]}},
    {"name": "familyEntries", "op": "join", "from": "groupEntries", "with": "families",
      "left": ["$row.kind"], "right": ["$row.key"], "mode": "one", "as": "family"},
    {"name": "grade2Rules", "op": "map", "from": "familyEntries", "row": {"record": {
      "braille": "$row.braille",
      "citation": {"cite": {"record": {"source": "ueb-2024", "locator": "$row.family.locator"}}},
      "id": {"concat": ["@expansion.ids.contractionPrefix", "$row.family.locator", "@expansion.ids.separator", "$row.print"]},
      "kind": "$row.kind", "print": "$row.print",
      "guards": {"concat": ["$row.family.guards", "$row.guards"]},
      "precedence": "$row.precedence", "variants": "$row.variants"
    }}},

    {"name": "constraints", "op": "table", "source": "constraints"},
    {"name": "constraintTargets", "op": "join", "from": "constraints", "with": "grade2Rules",
      "left": ["$row.target.kind", "$row.target.print"], "right": ["$row.kind", "$row.print"],
      "mode": "one", "as": "rule"},
    {"name": "constraintSources", "op": "map", "from": "constraintTargets", "row": {"record": {
      "citation": {"cite": "$row.citation"},
      "target": {"record": {"kind": "$row.target.kind", "print": "$row.target.print"}},
      "guards": {"flatten": {"each": ["$row.guards", "guard",
        {"if": [{"eq": ["$guard.kind", "not-word-ending"]},
          {"if": [{"isEmpty": "$guard.endings"}, {"list": []},
            {"list": [{"record": {"kind": "not-word-ending", "endings": "$guard.endings"}}]}]},
          {"if": [{"eq": ["$guard.kind", "not-word"]},
            {"if": [{"isEmpty": {"call": ["constraintWords", "$guard"]}}, {"list": []},
              {"list": [{"record": {"kind": "not-word", "words": {"call": ["constraintWords", "$guard"]}, "ignoredCharacters": "$guard.ignoredCharacters"}}]}]},
            {"if": [{"eq": ["$guard.kind", "following-not-vowel-y-except-words"]},
              {"list": [{"record": {"kind": "following-not-vowel-y-except-words", "words": {"call": ["constraintWords", "$guard"]}, "characters": "$guard.characters"}}]},
              {"fail": {"concat": ["Unsupported constraint guard ", "$guard.kind"]}}]}]}]}
      ]}}
    }}},
    {"name": "constrainedRules", "op": "join", "from": "grade2Rules", "with": "constraintSources",
      "left": ["$row.kind", "$row.print"], "right": ["$row.target.kind", "$row.target.print"],
      "mode": "all", "as": "constraints"},

    {"name": "collisionSigns", "op": "filter", "from": "grade2Rules", "where": {"in": ["$row.kind", "@expansion.collisionKinds"]}},
    {"name": "symbols", "op": "table", "source": "symbols"},
    {"name": "latinLetters", "op": "filter", "from": "symbols", "where": {"and": [
      {"eq": ["$row.kind", "@expansion.latinKind"]},
      {"test": ["@expansion.latinPattern", "$row.print"]}
    ]}},
    {"name": "spellings", "op": "concat", "from": ["collisionSigns", "latinLetters"]},
    {"name": "shortformPairs", "op": "table", "source": "shortforms"},
    {"name": "shortforms", "op": "map", "from": "shortformPairs", "row": {"record": {
      "braille": "$row.1", "citation": {"cite": "@expansion.citation"},
      "id": {"concat": ["@expansion.ids.shortformPrefix", "$row.0"]}, "print": "$row.0"
    }}},
    {"name": "appendix", "op": "table", "source": "appendix"},
    {"name": "appendixWords", "op": "flatMap", "from": "appendix", "rows": {"each": ["$row.words", "word", {"record": {
      "base": "$row.base", "citation": {"cite": "@expansion.citation"},
      "id": {"concat": ["@expansion.ids.appendixPrefix", "$row.base", "@expansion.ids.separator", "$word"]},
      "print": "$word",
      "withoutBase": {"replaceFirst": ["$word", "$row.base", ""]}
    }}]}},
    {"name": "appendixSources", "op": "map", "from": "appendixWords", "row": {"record": {
      "base": "$row.base", "citation": "$row.citation", "id": "$row.id", "print": "$row.print"
    }}},
    {"name": "longerGroups", "op": "table", "source": "longerShortforms"},
    {"name": "longerWords", "op": "flatMap", "from": "longerGroups", "rows": {"each": ["$row.words", "word",
      {"record": {"word": "$word", "guards": "$row.guards"}}]}},
    {"name": "shortformAppendix", "op": "join", "from": "shortforms", "with": "appendixWords",
      "left": ["$row.print"], "right": ["$row.base"], "mode": "all", "as": "appendix"},
    {"name": "shortformInfo", "op": "join", "from": "shortformAppendix", "with": "longerWords",
      "left": ["$row.print"], "right": ["$row.word"], "mode": "first", "as": "longer"},
    {"name": "readings", "op": "decode", "from": "shortformInfo", "cells": "$row.braille", "alphabet": "spellings"},
    {"name": "collisionReadings", "op": "filter", "from": "readings", "where": {"not": {"eq": ["$row.reading.literal", "$row.print"]}}},
    {"name": "collisionTargets", "op": "flatMap", "from": "collisionReadings", "rows": {"each": [
      {"where": ["$row.reading.ids", "id", {"in": ["$id", {"column": ["collisionSigns", "id"]}]}]},
      "target",
      {"record": {
        "target": "$target",
        "words": {"flatten": {"each": [
          {"concat": [
            {"list": [{"list": ["$row.print", "$row.reading.literal"]}]},
            {"each": ["$row.appendix", "entry", {"list": ["$entry.print", {"replaceFirst": ["$entry.print", "$row.print", "$row.reading.literal"]}]}]}
          ]},
          "form",
          {"concat": [
            {"list": ["$form.1"]},
            {"flatten": {"each": [{"call": ["shortformSuffixes", "$form.0"]}, "suffix", {"concat": [
              {"list": [{"concat": ["$form.1", "$suffix"]}]},
              {"each": [{"at": ["@expansion.suffixExtensions", "$suffix", {"list": []}]}, "extension",
                {"concat": ["$form.1", "$suffix", "$extension"]}]}
            ]}]}}
          ]}
        ]}},
        "patterns": {"if": [{"eq": ["$row.longer", null]}, {"list": []},
          {"list": [{"call": ["longerPattern", "$row.longer.guards", "$row.reading.literal"]}]}]}
      }}
    ]}},
    {"name": "collisionGroups", "op": "group", "from": "collisionTargets", "by": "$row.target",
      "collect": {"words": "$row.words", "patterns": "$row.patterns"}},
    {"name": "collisionGuards", "op": "map", "from": "collisionGroups", "row": {"record": {
      "target": "$row.key",
      "guards": {"concat": [
        {"list": [{"record": {"kind": "not-standing-word", "ignoredCharacters": "", "words": "$row.words"}}]},
        {"each": ["$row.patterns", "pattern", {"record": {"kind": "not-standing-match", "pattern": "$pattern"}}]}
      ]}
    }}},

    {"name": "collidedRules", "op": "join", "from": "constrainedRules", "with": "collisionGuards",
      "left": ["$row.id"], "right": ["$row.target"], "mode": "first", "as": "collision"},
    {"name": "generalRules", "op": "map", "from": "collidedRules", "row": {"record": {
      "braille": "$row.braille", "citation": "$row.citation",
      "guards": {"concat": [
        "$row.guards",
        {"flatten": {"each": ["$row.constraints", "constraint", "$constraint.guards"]}},
        {"at": ["$row.collision", "guards", {"list": []}]}
      ]},
      "id": "$row.id", "input": "$row.print", "precedence": "$row.precedence",
      "variants": "$row.variants"
    }}},
    {"name": "contractionRules", "op": "flatMap", "from": "generalRules", "rows": {"concat": [
      {"list": [{"record": {
        "braille": "$row.braille", "citation": "$row.citation", "guards": "$row.guards",
        "id": "$row.id", "input": "$row.input", "precedence": "$row.precedence"
      }}]},
      {"each": ["$row.variants", "variant", {"record": {
        "braille": "$row.braille",
        "citation": {"merge": ["$row.citation", {"record": {"locator": "$variant.locator"}}]},
        "guards": {"concat": ["$row.guards", "$variant.guards"]},
        "id": {"concat": ["$row.id", "@expansion.ids.separator", "$variant.idSuffix"]},
        "input": "$row.input", "precedence": "$variant.precedence"
      }}]}
    ]}},
    {"name": "wholeShortforms", "op": "map", "from": "shortforms", "row": {"record": {
      "braille": "$row.braille", "citation": "$row.citation",
      "guards": {"concat": ["@expansion.shortformGuards",
        {"list": [{"record": {"kind": "word-with-affixes", "affixes": {"call": ["shortformSuffixes", "$row.print"]}}}]}]},
      "id": "$row.id", "input": "$row.print", "precedence": "@expansion.shortformPrecedence"
    }}},
    {"name": "longerShortforms", "op": "filter", "from": "shortformInfo", "where": {"not": {"eq": ["$row.longer", null]}}},
    {"name": "longerRules", "op": "map", "from": "longerShortforms", "row": {"record": {
      "braille": "$row.braille", "citation": "$row.citation",
      "guards": "$row.longer.guards",
      "id": {"concat": ["$row.id", "@expansion.ids.longerSuffix"]},
      "input": "$row.print", "precedence": "@expansion.longerPrecedence"
    }}},
    {"name": "appendixBases", "op": "join", "from": "appendixWords", "with": "shortforms",
      "left": ["$row.base"], "right": ["$row.print"], "mode": "one", "as": "shortform"},
    {"name": "appendixRules", "op": "map", "from": "appendixBases", "row": {"record": {
      "braille": "$row.shortform.braille", "citation": "$row.citation",
      "guards": {"concat": ["@expansion.appendixGuards",
        {"list": [{"record": {"kind": "eligibility-word", "pluralSuffix": "@expansion.pluralSuffix", "word": "$row.print"}}]}]},
      "id": "$row.id", "input": "$row.base", "precedence": "@expansion.appendixPrecedence"
    }}},
    {"name": "rules", "op": "concat", "from": ["contractionRules", "wholeShortforms", "longerRules", "appendixRules"]},

    {"name": "longerAmbiguities", "op": "flatMap", "from": "longerRules", "rows": {"if": [
      {"eq": [{"spell": ["$row.braille", "latinLetters", "braille", "print"]}, null]}, {"list": []},
      {"list": [{"call": ["longerPattern", "$row.guards", {"spell": ["$row.braille", "latinLetters", "braille", "print"]}]}]}
    ]}},
    {"name": "spelledRules", "op": "map", "from": "rules", "row": {"record": {
      "rule": "$row", "letters": {"spell": ["$row.braille", "latinLetters", "braille", "print"]}
    }}},
    {"name": "letterRules", "op": "filter", "from": "spelledRules", "where": {"not": {"eq": ["$row.letters", null]}}},
    {"name": "ambiguityEntries", "op": "flatMap", "from": "letterRules", "rows": {"concat": [
      {"each": [
        {"concat": [{"list": [""]}, {"where": [
          {"flatten": {"each": [{"where": ["$row.rule.guards", "guard", {"eq": ["$guard.kind", "word-with-affixes"]}]}, "guard", "$guard.affixes"]}},
          "affix", {"not": {"eq": [{"spell": ["$affix", "latinLetters", "print", "braille"]}, null]}}
        ]}]},
        "affix",
        {"list": [{"concat": ["$row.letters", "$affix"]}, {"concat": ["$row.rule.braille", {"spell": ["$affix", "latinLetters", "print", "braille"]}]}]}
      ]},
      {"each": [
        {"flatten": {"each": [
          {"where": ["$row.rule.guards", "guard", {"and": [
            {"eq": ["$guard.kind", "eligibility-word"]},
            {"startsWith": ["$guard.word", "$row.rule.input"]},
            {"not": {"eq": [{"spell": ["$guard.word", "latinLetters", "print", "braille"]}, null]}}
          ]}]},
          "guard",
          {"list": [{"after": ["$guard.word", "$row.rule.input"]}, {"concat": [{"after": ["$guard.word", "$row.rule.input"]}, "$guard.pluralSuffix"]}]}
        ]}},
        "suffix",
        {"list": [{"concat": ["$row.letters", "$suffix"]}, {"concat": ["$row.rule.braille", {"spell": ["$suffix", "latinLetters", "print", "braille"]}]}]}
      ]}
    ]}},
    {"name": "distinctAmbiguities", "op": "distinct", "from": "ambiguityEntries", "by": "$row.0"},
    {"name": "ambiguities", "op": "sort", "from": "distinctAmbiguities", "by": "$row.0"},

    {"name": "standingWords", "op": "filter", "from": "grade2Rules", "where": {"in": ["$row.kind", "@expansion.standingWordKinds"]}},
    {"name": "standingLiteralRules", "op": "filter", "from": "grade2Rules", "where": {"and": [
      {"in": ["$row.kind", "@expansion.standingLiteralKinds"]},
      {"in": ["$row.braille", {"column": ["standingWords", "braille"]}]}
    ]}},
    {"name": "standingLiteralPrints", "op": "flatMap", "from": "standingLiteralRules", "rows": {"list": ["$row.print"]}},
    {"name": "standingLiterals", "op": "sort", "from": "standingLiteralPrints", "by": "$row"},
    {"name": "alphabet", "op": "flatMap", "from": "latinLetters", "rows": {"list": ["$row.print"]}}
  ],
  "outputs": {
    "grade2Rules": "grade2Rules",
    "shortforms": "shortforms",
    "appendix": "appendixSources",
    "constraints": "constraintSources",
    "rules": "rules",
    "ambiguities": "ambiguities",
    "longerAmbiguities": "longerAmbiguities",
    "standingLiterals": "standingLiterals",
    "alphabet": "alphabet"
  }
}
